# LLM Configuration (OpenAI-compatible API: DeepSeek, Qwen, OpenAI, Gemini OpenAI endpoint, etc.)
# Leave empty to use the built-in multi-agent analytical engine & deterministic tactical reasoning fallback
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Database Path
LOL_DB_PATH=data/lol_esports.db

# Leaguepedia Cargo API User-Agent (recommended by Fandom/MediaWiki API policy)
LEAGUEPEDIA_USER_AGENT=LoLMVPPredictor/1.0 (Esports Analytics Research)
